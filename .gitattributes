# Auto-detect text files and normalize line endings
* text=auto

# Notebooks — treat as binary to avoid merge conflicts
*.ipynb -text

# Large model/binary files
*.safetensors binary
*.ckpt binary
*.pt binary
*.bin binary

# Images are binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Ensure markdown files use LF in the repository
*.md text eol=lf
